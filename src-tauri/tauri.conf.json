{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperFlow",
  "version": "0.1.0",
  "identifier": "io.github.ammarqaisar11a55.paperflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Office",
    "shortDescription": "Offline PDF toolkit",
    "longDescription": "PaperFlow merges, splits, compresses, organizes, converts, watermarks, protects and OCRs PDF files entirely on your computer. Nothing is uploaded.",
    "copyright": "Copyright © 2026 Muhammad Ammar Qaisar",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["ghostscript", "poppler-utils", "qpdf", "tesseract-ocr", "tesseract-ocr-eng"]
      }
    }
  }
}

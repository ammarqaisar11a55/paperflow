<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ammarqaisar11a55.paperflow</id>
  <name>PaperFlow</name>
  <summary>Offline PDF toolkit</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.ammarqaisar11a55">
    <name>Muhammad Ammar Qaisar</name>
  </developer>
  <description>
    <p>
      PaperFlow is a complete PDF toolkit that works entirely on your computer. Nothing is
      uploaded, no account is needed, and it works without an internet connection.
    </p>
    <ul>
      <li>Merge, split, organize, rotate and extract pages</li>
      <li>Compress PDFs with quality presets</li>
      <li>Convert Word, PowerPoint, Excel and HTML files to PDF</li>
      <li>Convert PDFs to images, text and Markdown</li>
      <li>Add watermarks and page numbers with a live preview</li>
      <li>Edit metadata, protect with a password, or unlock with yours</li>
      <li>Make scanned documents searchable with OCR</li>
      <li>Read and search PDFs in the built-in viewer</li>
    </ul>
  </description>
  <launchable type="desktop-id">paperflow.desktop</launchable>

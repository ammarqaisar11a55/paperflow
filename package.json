{
  "name": "paperflow",
  "private": true,
  "version": "0.1.0",
  "description": "Offline PDF toolkit. Your PDFs. Your Device. Your Privacy.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
